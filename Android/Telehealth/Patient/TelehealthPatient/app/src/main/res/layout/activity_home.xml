<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightBackground"
    tools:context="com.redimed.telehealth.patient.HomeActivity">

    <ImageView
        android:id="@+id/imgViewLogo"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/logo_redimed" />

    <android.support.v4.widget.DrawerLayout
        android:id="@+id/drawerCategories"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/leftLayout"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_gravity="left|start"
            android:background="#dcffffff"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/avatarPatient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/img_avatar_caller"/>

            <TextView
                android:id="@+id/lblNamePatient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="30dp"
                android:singleLine="true"
                android:gravity="center"
                android:text="Welcome Patient"
                android:layout_below="@+id/avatarPatient"/>

            <android.support.v7.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/lblNamePatient"/>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/txtHomeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="80dp"
                android:text="@string/title_remote"
                android:textColor="@color/redFont"
                android:textSize="@dimen/size_title" />

            <ImageView
                android:id="@+id/imgHome"
                android:layout_width="400dp"
                android:layout_height="400dp"
                android:layout_below="@+id/txtHomeTitle"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:background="@drawable/logo_bg_redimed" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imgHome">

                <Button
                    android:id="@+id/testSession"
                    android:layout_width="120dp"
                    android:layout_height="50dp"
                    android:text="Register Session" />

                <Button
                    android:id="@+id/testSocket"
                    android:layout_width="120dp"
                    android:layout_height="50dp"
                    android:text="Request Socket" />

            </LinearLayout>

        </RelativeLayout>

    </android.support.v4.widget.DrawerLayout>

</RelativeLayout>
