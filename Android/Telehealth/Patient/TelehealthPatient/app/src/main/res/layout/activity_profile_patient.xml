<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.redimed.telehealth.patient.ProfilePatientActivity">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/splash_screen_background" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="?android:actionBarSize"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp"
        android:src="@drawable/logo_redimed" />

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_below="@+id/logo">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/layoutUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentLeft="true"
                android:padding="12dp"
                android:layout_below="@+id/logo">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="bottom"
                    android:background="@drawable/person_icon"/>

                <android.support.design.widget.TextInputLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp">

                    <EditText
                        android:id="@+id/txtFirstName"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:hint="First Name"
                        android:inputType="text"
                        android:layout_gravity="bottom"/>
                </android.support.design.widget.TextInputLayout>

                <android.support.design.widget.TextInputLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/txtLastName"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:hint="Last Name"
                        android:inputType="text"
                        android:singleLine="true"
                        android:layout_gravity="bottom"/>
                </android.support.design.widget.TextInputLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentLeft="true"
                android:padding="12dp"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/layoutUserName">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="bottom"
                    android:background="@drawable/phone_icon"/>

                <android.support.design.widget.TextInputLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp">

                    <EditText
                        android:id="@+id/txtPhone"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:hint="Phone Number"
                        android:inputType="number"
                        android:singleLine="true"
                        android:maxLength="15"
                        android:layout_gravity="bottom"/>
                </android.support.design.widget.TextInputLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutDOB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentLeft="true"
                android:padding="12dp"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/layoutPhone">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="bottom"
                    android:background="@drawable/birthday_icon"/>

                <android.support.design.widget.TextInputLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp">

                    <EditText
                        android:id="@+id/txtDOB"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:hint="Date of Birth"
                        android:inputType="number"
                        android:singleLine="true"
                        android:layout_gravity="bottom"/>
                </android.support.design.widget.TextInputLayout>
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/layoutAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentLeft="true"
                android:padding="12dp"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/layoutDOB">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="bottom"
                    android:background="@drawable/birthday_icon"
                    android:id="@+id/imgAddress" />

                <android.support.design.widget.TextInputLayout
                    android:id="@+id/txtLayoutAddress1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_gravity="bottom"
                    android:layout_toRightOf="@+id/imgAddress">

                    <EditText
                        android:id="@+id/txtAddress1"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:hint="Address1"
                        android:inputType="number"
                        android:singleLine="true"/>

                </android.support.design.widget.TextInputLayout>

                <android.support.design.widget.TextInputLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_below="@+id/txtLayoutAddress1"
                    android:layout_toRightOf="@+id/imgAddress">

                    <EditText
                        android:id="@+id/txtAddress2"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:hint="Address2"
                        android:inputType="number"
                        android:singleLine="true"
                        android:layout_gravity="bottom"/>
                </android.support.design.widget.TextInputLayout>

            </RelativeLayout>

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="300dp"
                android:layout_height="?android:actionBarSize"
                android:layout_marginTop="15dp"
                android:background="#67000000"
                android:fontFamily="sans-serif-light"
                android:text="Submit"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal"
                android:layout_below="@id/layoutAddress"/>
        </RelativeLayout>

    </ScrollView>


</RelativeLayout>
